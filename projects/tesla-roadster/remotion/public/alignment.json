 "lead_in": 0.25,
 "note": "seconds; Fish word timestamps",
 "sentences": [
  {
   "i": 0,
   "text": "这辆车，刚刚飞过了一辆大卡车。",
   "start": 0.25,
   "end": 2.523,
   "pause_after": 0.67,
   "take": "tb-00.mp3",
   "speed": 1.1
  },
  {
   "i": 1,
   "text": "不是特效。",
   "start": 3.193,
   "end": 4.133,
   "pause_after": 0.4,
   "take": "tb-01.mp3",
   "speed": 1.1
  },
  {
   "i": 2,
   "text": "也不是AI。",
   "start": 4.533,
   "end": 5.63,
   "pause_after": 0.72,
   "take": "tc-02.mp3",
   "speed": 1.1
  },
  {
   "i": 3,
   "text": "评论区问得最多的就一句。",
   "start": 6.35,
   "end": 7.943,
   "pause_after": 0.4,
   "take": "tb-03.mp3",
   "speed": 1.1
  },
  {
   "i": 4,
   "text": "它到底怎么飞起来的？",
   "start": 8.343,
   "end": 9.649,
   "pause_after": 0.57,
   "take": "ta-04.mp3",
   "speed": 1.1
  },
  {
   "i": 5,
   "text": "答案是，车上装了两套系统。",
   "start": 10.219,
   "end": 12.414,
   "pause_after": 0.7,
   "take": "ta-05.mp3",
   "speed": 1.1
  },
  {
   "i": 6,
   "text": "先看这里。",
   "start": 13.114,
   "end": 13.871,
   "pause_after": 0.4,
   "take": "tc-06.mp3",
   "speed": 1.1
  },
  {
   "i": 7,
   "text": "车头朝天，贴着竖直的墙往上开。",
   "start": 14.271,
   "end": 16.622,
   "pause_after": 0.4,
   "take": "ta-07.mp3",
   "speed": 1.1
  },
  {
   "i": 8,
   "text": "靠的是车底一个大风扇。",
   "start": 17.022,
   "end": 18.615,
   "pause_after": 0.4,
   "take": "tc-08.mp3",
   "speed": 1.1
  },
  {
   "i": 9,
   "text": "它把车底的空气抽走。",
   "start": 19.015,
   "end": 20.609,
   "pause_after": 0.4,
   "take": "tb-09.mp3",
   "speed": 1.1
  },
  {
   "i": 10,
   "text": "下面气压一低。",
   "start": 21.009,
   "end": 22.184,
   "pause_after": 0.4,
   "take": "tc-10.mp3",
   "speed": 1.1
  },
  {
   "i": 11,
   "text": "外面的空气，就把车死死按在墙上。",
   "start": 22.584,
   "end": 25.17,
   "pause_after": 0.4,
   "take": "tb-11.mp3",
   "speed": 1.1
  },
  {
   "i": 12,
   "text": "按住的力，最大有车重的两倍。",
   "start": 25.57,
   "end": 27.686,
   "pause_after": 0.8,
   "take": "ta-12.mp3",
   "speed": 1.1
  },
  {
   "i": 13,
   "text": "再看飞的这一下。",
   "start": 28.486,
   "end": 29.661,
   "pause_after": 0.4,
   "take": "tb-13.mp3",
   "speed": 1.1
  },
  {
   "i": 14,
   "text": "座椅后面，藏着一个高压气罐。",
   "start": 30.061,
   "end": 32.099,
   "pause_after": 0.4,
   "take": "ta-14.mp3",
   "speed": 1.1
  },
  {
   "i": 15,
   "text": "阀门一开，气体从车尾猛地喷出去。",
   "start": 32.499,
   "end": 35.085,
   "pause_after": 0.4,
   "take": "td-15.mp3",
   "speed": 1.1
  },
  {
   "i": 16,
   "text": "气往后喷，车就往前、往上冲。",
   "start": 35.485,
   "end": 37.627,
   "pause_after": 0.4,
   "take": "ta-16.mp3",
   "speed": 1.1
  },
  {
   "i": 17,
   "text": "跟你松开一个吹满的气球，是一个道理。",
   "start": 38.027,
   "end": 40.561,
   "pause_after": 0.4,
   "take": "tc-17.mp3",
   "speed": 1.1
  },
  {
   "i": 18,
   "text": "车身四周还有小喷口，在空中帮它转身。",
   "start": 40.961,
   "end": 43.651,
   "pause_after": 0.4,
   "take": "tc-18.mp3",
   "speed": 1.1
  },
  {
   "i": 19,
   "text": "这套技术，借自SpaceX的火箭。",
   "start": 44.051,
   "end": 46.324,
   "pause_after": 0.62,
   "take": "te-19.mp3",
   "speed": 1.1
  },
  {
   "i": 20,
   "text": "所以记住一句话。",
   "start": 46.944,
   "end": 47.962,
   "pause_after": 0.4,
   "take": "tb-20.mp3",
   "speed": 1.1
  },
  {
   "i": 21,
   "text": "风扇负责吸，喷气负责飞。",
   "start": 48.362,
   "end": 50.322,
   "pause_after": 0.9,
   "take": "tc-21.mp3",
   "speed": 1.04
  },
  {
   "i": 22,
   "text": "那你能开上它吗？",
   "start": 51.222,
   "end": 52.528,
   "pause_after": 0.4,
   "take": "tb-22.mp3",
   "speed": 1.1
  },
  {
   "i": 23,
   "text": "它2028年才量产。",
   "start": 52.928,
   "end": 54.73,
   "pause_after": 0.4,
   "take": "td-23.mp3",
   "speed": 1.1
  },
  {
   "i": 24,
   "text": "会飞的那个版本，只能在封闭场地玩。",
   "start": 55.13,
   "end": 57.716,
   "pause_after": 0.4,
   "take": "ta-24.mp3",
   "speed": 1.1
  },
  {
   "i": 25,
   "text": "售价没公布，订金最高二十五万美元。",
   "start": 58.116,
   "end": 60.572,
   "pause_after": 0.62,
   "take": "tg-25.mp3",
   "speed": 1.1
  },
  {
   "i": 26,
   "text": "如果真能买，你敢坐吗？",
   "start": 61.192,
   "end": 62.889,
   "pause_after": 0.72,
   "take": "ta-26.mp3",
   "speed": 1.1
  }
 ],
